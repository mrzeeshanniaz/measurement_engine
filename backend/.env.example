# =============================================================================
# TailorSync Measurement Engine — environment reference
# =============================================================================
# Copy to `.env` and edit. Every setting below has a sensible default in
# app/config.py; only override what differs for your environment.
#
# Sections:
#   1. Runtime
#   2. Camera / scale defaults
#   3. Firebase / Firestore (auth + profile persistence)
#   4. CORS
#   5. Production hardening (size limits, rate limiting)
#   6. Job store
#   7. Metrics
#   8. Image storage (S3 / GCS / in-memory)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Runtime
# -----------------------------------------------------------------------------
# DEBUG=true switches log level to DEBUG and enables verbose pipeline traces.
DEBUG=false
# Inference device for SMPL fitter — "cpu" or "cuda".
DEVICE=cpu
# Where downloaded model files are cached (MediaPipe pose, segmenter).
MODEL_CACHE_DIR=./models


# -----------------------------------------------------------------------------
# 2. Camera / scale defaults
# -----------------------------------------------------------------------------
# Fallback focal-length and sensor-width values used by the height estimator
# when the mobile client does not supply CameraMetadata.
DEFAULT_FOCAL_LENGTH_MM=4.25
DEFAULT_SENSOR_WIDTH_MM=4.8


# -----------------------------------------------------------------------------
# 3. Firebase / Firestore  (A2 + A3)
# -----------------------------------------------------------------------------
# AUTH_ENABLED=true makes /submit, /manual, and all /profiles endpoints
# require a valid Firebase ID token via the Authorization: Bearer header.
AUTH_ENABLED=false

# Path to a Firebase service-account JSON file.
# Omit on Cloud Run / GCP — ADC (Application Default Credentials) is used.
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-sa.json

# GCP project ID — usually inferred from the credentials, override only when
# multiple projects share the same service account.
# FIREBASE_PROJECT_ID=tailorsync-prod


# -----------------------------------------------------------------------------
# 4. CORS
# -----------------------------------------------------------------------------
# Comma-separated allowed origins. Use "*" only in development.
# Production example:
#   CORS_ORIGINS=https://tailorsync.app,https://www.tailorsync.app
CORS_ORIGINS=*


# -----------------------------------------------------------------------------
# 5. Production hardening — size limits + rate limiting
# -----------------------------------------------------------------------------
# Per-frame base64 payload size cap (bytes). 10 MB ≈ a 10 MP JPEG @ q=90.
MAX_FRAME_B64_BYTES=10485760

# Total request body cap (bytes). 8 frames × 10 MB + JSON overhead ≈ 90 MB.
# When IMAGE_STORE_BACKEND=s3 this can drop to ~64 KB (keys only).
MAX_REQUEST_BODY_BYTES=94371840

# Per-IP (or per-token when authenticated) rate limits.
# Format: "<count>/<period>" — period ∈ second | minute | hour | day.
RATE_LIMIT_SUBMIT=30/minute
RATE_LIMIT_MANUAL=60/minute


# -----------------------------------------------------------------------------
# 6. Job store
# -----------------------------------------------------------------------------
# "memory" — process-local; lost on restart. Use for tests + dev.
# "sqlite" — file-backed, restart-safe. Use in production single-instance.
# (Future: "redis" for horizontal scaling.)
JOB_STORE_BACKEND=sqlite
JOB_STORE_SQLITE_PATH=./data/job_store.db


# -----------------------------------------------------------------------------
# 7. Metrics
# -----------------------------------------------------------------------------
# Expose Prometheus metrics at GET /metrics. Set false to disable.
METRICS_ENABLED=true


# -----------------------------------------------------------------------------
# 8. Image storage
# -----------------------------------------------------------------------------
# IMAGE_STORE_BACKEND selects where pose frames live:
#   "memory" — base64 inline in /submit (default; works without S3 setup).
#   "s3"     — mobile PUTs to presigned S3 URLs; /submit carries keys only.
#              Drops request-body size 10000× and decouples upload from
#              pipeline runtime. Required at scale.
IMAGE_STORE_BACKEND=memory

# ---- S3 / S3-compatible (required when IMAGE_STORE_BACKEND=s3) --------------
# IAM principal that signs uploads and reads/deletes objects.
# Scope the IAM policy to s3:PutObject + s3:GetObject + s3:DeleteObject on
# arn:aws:s3:::${S3_UPLOAD_BUCKET}/scans/* — never grant ListBucket here.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=ap-south-1

# Bucket name (globally unique). Create with:
#   - Block all public access ON
#   - Default encryption: SSE-S3 (AES256)
#   - Lifecycle rule: expire objects 1 day after upload
#   - CORS: AllowedMethods=[PUT], AllowedOrigins=[*]
# S3_UPLOAD_BUCKET=tailorsync-scan-uploads

# Presigned PUT URL lifetime (seconds). Keep short — leaked URLs go stale fast.
S3_UPLOAD_URL_TTL_SECONDS=600

# Hard byte ceiling enforced in the presigned PUT policy. 8 MB is 4–5× a
# typical compressed body-scan JPEG at 1024×1280.
S3_UPLOAD_MAX_BYTES=8388608

# Optional — use for MinIO, Cloudflare R2, LocalStack, etc.
# Leave unset for real AWS S3.
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
